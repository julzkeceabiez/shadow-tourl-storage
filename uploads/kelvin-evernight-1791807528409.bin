            "text": "{\"operationName\":\"getLinkRecommendationsByIdentifier\",\"variables\":{\"linkIdentificationInput\":{\"userIdAndUrl\":{\"url\":\"resource-pack-hd\",\"user_id\":\"519136\"}}},\"query\":\"query getLinkRecommendationsByIdentifier($linkIdentificationInput: PublicLinkIdentificationInput!) {\\n  linkRecommendationsByIdentifier(\\n    linkIdentificationInput: $linkIdentificationInput\\n  ) {\\n    ...ResultCardFields\\n    recently_edited\\n    __typename\\n  }\\n}\\n\\nfragment ResultCardFields on PublicLink {\\n  __typename\\n  id\\n  url\\n  target_host\\n  target_type\\n  title\\n  positive_rating\\n  is_premium_only\\n  publisher {\\n    id\\n    name\\n    avatar_color\\n    is_subscriber\\n    __typename\\n  }\\n  already_rated_by_user\\n  is_trending\\n  view_count\\n  filtered_link_images {\\n    url\\n    is_blurred\\n    __typename\\n  }\\n  user_rating\\n  percentage_rating\\n  seo_classification\\n  effective_published_at\\n  href\\n}\"}"
          }
