            "text": "{\"operationName\":\"getLinkByIdentifier\",\"variables\":{\"identifier\":{\"userIdAndUrl\":{\"url\":\"resource-pack-hd\",\"user_id\":\"519136\"}}},\"query\":\"query getLinkByIdentifier($identifier: PublicLinkIdentificationInput!) {\\n  linkByIdentifier(linkIdentificationInput: $identifier) {\\n    ...ResultCardFields\\n    video_url\\n    recently_edited\\n    description\\n    seo_faqs {\\n      title\\n      body\\n      __typename\\n    }\\n    negative_rating\\n    published_at\\n    isPublished\\n    publisher {\\n      subscriber_count\\n      __typename\\n    }\\n    __typename\\n  }\\n}\\n\\nfragment ResultCardFields on PublicLink {\\n  __typename\\n  id\\n  url\\n  target_host\\n  target_type\\n  title\\n  positive_rating\\n  is_premium_only\\n  publisher {\\n    id\\n    name\\n    avatar_color\\n    is_subscriber\\n    __typename\\n  }\\n  already_rated_by_user\\n  is_trending\\n  view_count\\n  filtered_link_images {\\n    url\\n    is_blurred\\n    __typename\\n  }\\n  user_rating\\n  percentage_rating\\n  seo_classification\\n  effective_published_at\\n  href\\n}\"}"
